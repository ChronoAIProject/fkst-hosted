# Rust build artifacts
backend/target/
**/*.rs.bk

# Node
node_modules/

# Secrets and credentials — never commit these
.env
.env.*
!frontend/.env.example
!backend/.env.example
*.pem
*.key
credentials.json

# Local PRODUCTION manifests (hold real cluster values/secrets) — never commit.
backend/k8s_prod/
frontend/k8s_prod/

# Local AI-agent session state (worktrees, settings) — never commit.
.claude/

# OS noise
.DS_Store

# /auto engine working state
.auto/
.gstack/

# FKST Evolution build output: journey recordings, caption tracks, and the
# rendered PDF/MP4 that section 24.1 stores as GitHub Release assets rather than
# in Git history. Regenerate with `npm run evolution:journeys` + render-media.
tools/evolution/out/
