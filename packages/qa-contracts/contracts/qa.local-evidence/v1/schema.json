{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chronoai:fkst:qa-contracts:qa.local-evidence:v1",
  "$defs": {
    "RunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "Attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "FixedFixtureUrl": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:([0-9]+)/fixed-page\\.html$"
    },
    "EvidenceId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^evidence/[0-9]+$"
    },
    "ObservationId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^observation/[0-9]+$"
    },
    "ContentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ReferenceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "LocalSanitizedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "attempt",
        "fixture_url",
        "final_url",
        "selector",
        "expected_text",
        "observed_text"
      ],
      "properties": {
        "schema_version": { "const": "qa.local-evidence/v1" },
        "run_id": { "$ref": "#/$defs/RunId" },
        "attempt": { "$ref": "#/$defs/Attempt" },
        "fixture_url": { "$ref": "#/$defs/FixedFixtureUrl" },
        "final_url": { "$ref": "#/$defs/FixedFixtureUrl" },
        "selector": { "const": "[data-local-qa=\"status\"]" },
        "expected_text": { "const": "READY" },
        "observed_text": { "const": "READY" }
      }
    },
    "LocalEvidenceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "attempt",
        "object_id",
        "role",
        "media_type",
        "byte_length",
        "sha256",
        "ownership"
      ],
      "properties": {
        "schema_version": { "const": "qa.local-evidence/v1" },
        "run_id": { "$ref": "#/$defs/RunId" },
        "attempt": { "$ref": "#/$defs/Attempt" },
        "object_id": { "$ref": "#/$defs/EvidenceId" },
        "role": { "enum": ["browser-screenshot", "runner-log"] },
        "media_type": { "enum": ["image/png", "text/plain; charset=utf-8"] },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ownership": { "const": "local-only:not-uploadable" }
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["role", "media_type"],
          "properties": {
            "role": { "const": "browser-screenshot" },
            "media_type": { "const": "image/png" }
          }
        },
        {
          "type": "object",
          "required": ["role", "media_type"],
          "properties": {
            "role": { "const": "runner-log" },
            "media_type": { "const": "text/plain; charset=utf-8" }
          }
        }
      ]
    },
    "LocalSanitizedObservationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "schema_version", "content_digest"],
      "properties": {
        "kind": { "const": "local-sanitized-observation" },
        "id": { "$ref": "#/$defs/ObservationId" },
        "schema_version": { "const": "qa.local-evidence/v1" },
        "content_digest": { "$ref": "#/$defs/ContentDigest" },
        "version": { "$ref": "#/$defs/ReferenceVersion" }
      }
    },
    "LocalEvidenceObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "schema_version", "content_digest"],
      "properties": {
        "kind": { "const": "local-evidence-object" },
        "id": { "$ref": "#/$defs/EvidenceId" },
        "schema_version": { "const": "qa.local-evidence/v1" },
        "content_digest": { "$ref": "#/$defs/ContentDigest" },
        "version": { "$ref": "#/$defs/ReferenceVersion" }
      }
    }
  }
}
