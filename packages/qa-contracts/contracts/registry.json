    "LocalQARunRequest": { "schema": "qa.local-run-admission/v1", "pointer": "#/$defs/LocalQARunRequest" },
    "RunAcceptance": { "schema": "qa.local-run-admission/v1", "pointer": "#/$defs/RunAcceptance" }
