# Copy this file to .env (gitignored) and fill in your local paths:
#   cp env.example .env
# Loaded by scripts/integration.sh (and the commands in README.md).

# Path to the fkst-framework binary built from the fkst-substrate repo.
# Typically the sibling checkout: <parent>/fkst-substrate/target/debug/fkst-framework
BIN=/path/to/fkst-substrate/target/debug/fkst-framework

# --- Optional host config (for real runs; the integration test sets its own) ---
# FKST_GITHUB_REPO=owner/repo
# FKST_GITHUB_WRITE=1

# --- Runtime roots (only for real `fkst-framework supervise` / dogfood runs) ---
# FKST_RUNTIME_ROOT: best-effort scratch (worktrees/locks/logs/once-marks).
# FKST_DURABLE_ROOT: durable delivery store (redb). REQUIRED once any reliable
#   subscription exists (default), else supervise fail-closes at startup.
#   Must NOT point at the same disposable dir as FKST_RUNTIME_ROOT.
# FKST_RUNTIME_ROOT=/path/to/scratch
# FKST_DURABLE_ROOT=/path/to/durable
