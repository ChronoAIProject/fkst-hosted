# ==============================================================================
# FKST Hosted Backend - Environment Variables Template (.env.example)
# ==============================================================================
#
# Copy this file to '.env' in the backend directory to configure the API server.
#
# This file documents two configuration profiles:
# (A) DEFAULT/production: Full NyxID authentication enabled, fail-closed posture, GitHub App active.
# (B) DEV/observer: Authentication disabled (all routes open), zero secrets, no GitHub App.
#
# ------------------------------------------------------------------------------
# PROFILE (A) - DEFAULT/PRODUCTION PROFILE (Full Auth, GitHub App Integration)
# ------------------------------------------------------------------------------
# FKST_AUTH_ENABLED=true
# FKST_AUTH_NYXID_BASE_URL=https://nyx.chrono-ai.fun
# FKST_AUTH_ISSUER=nyxid
# FKST_AUTH_AUDIENCE=https://nyx.chrono-ai.fun
# FKST_GITHUB_APP_ID=123456
# FKST_GITHUB_APP_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# FKST_GITHUB_APP_SLUG=fkst-hosted
# FKST_GITHUB_WRITE=REAL # Engine/deployment-level — not consumed by fkst-control-plane
#
# ------------------------------------------------------------------------------
# PROFILE (B) - DEV/OBSERVER PROFILE (Local Dev, Open Routes, Zero Secrets)
# ------------------------------------------------------------------------------
# FKST_AUTH_ENABLED=false
# # GitHub App configuration is omitted (disabled posture).
# # NyxID client credentials are omitted (owner-only policy).
# FKST_GITHUB_WRITE=DRY-RUN # Engine/deployment-level — not consumed by fkst-control-plane

# ==============================================================================
# DETAILED ENV VAR CONFIGURATION & DEFAULTS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Datastore Configuration
# ------------------------------------------------------------------------------
# The controller is datastore-free (#143): there is NO database. Sessions live
# in an in-memory store, goals are GitHub-Issue + in-memory backed, the journal's
# sole machine-truth is the committed GitHub file, and secrets are held in memory
# only. No MONGODB_* (or any other datastore) variable is read or required.


# ------------------------------------------------------------------------------
# 2. HTTP Server Configuration
# ------------------------------------------------------------------------------

# Optional. TCP port the HTTP server binds to.
# Default: 8080
FKST_HOSTED_PORT=8080

# Optional. Bind address.
# Default: 0.0.0.0
FKST_HOSTED_BIND_ADDR=0.0.0.0

# Optional. tracing-subscriber EnvFilter directive (e.g. debug, info, fkst_control_plane=debug).
# Default: info
FKST_HOSTED_LOG_LEVEL=info

# Optional. Per-request timeout in seconds for tower-http TimeoutLayer.
# Must be >= 1.
# Default: 30
FKST_HOSTED_REQUEST_TIMEOUT_SECS=30


# ------------------------------------------------------------------------------
# 3. NyxID JWT Authentication (FKST_AUTH_*)
# ------------------------------------------------------------------------------

# Optional. Master toggle for NyxID JWT verification.
# Default: true (fail-closed, must explicitly set to false to disable)
FKST_AUTH_ENABLED=true

# Required when FKST_AUTH_ENABLED is true. Base URL of the NyxID service.
# Trailing slashes are automatically trimmed.
FKST_AUTH_NYXID_BASE_URL=https://nyx.chrono-ai.fun

# Optional. Expected JWT issuer ('iss') claim. Must match the issuer in the NyxID token.
# Default: nyxid
FKST_AUTH_ISSUER=nyxid

# Optional. Expected JWT audience ('aud') claim. Defaults to the FKST_AUTH_NYXID_BASE_URL value.
FKST_AUTH_AUDIENCE=https://nyx.chrono-ai.fun

# Optional. JWKS public key cache TTL in seconds. Must be >= 1.
# Default: 300
FKST_AUTH_JWKS_CACHE_TTL_SECS=300


# ------------------------------------------------------------------------------
# 4. NyxID (owner-only credential model)
# ------------------------------------------------------------------------------
# The control plane needs NO service-account credential: every NyxID call
# (per-session key mint, Ornn proxy, github_hub, repo-create, user-orgs)
# authenticates with the forwarded user token. Only the cache TTL is tunable.

# Optional. TTL in seconds for the NyxID user-orgs membership cache.
# Default: 30
FKST_NYXID_ORG_CACHE_TTL_SECS=30

# Optional. TTL in seconds for the per-session NyxID agent key. The key is minted
# with expires_at = now + this, so it self-expires (the cleanup mechanism — there
# is no service-account revoke, which NyxID rejects on a human-minted key). >= 1.
# Default: 86400 (24h)
FKST_SESSION_KEY_TTL_SECS=86400


# ------------------------------------------------------------------------------
# 5. GitHub App Integration (Session Work & Git Posture)
# ------------------------------------------------------------------------------
# Configures session-scoped git operations (cloning, writing files, pushing).
# Module is disabled if FKST_GITHUB_APP_ID is unset.

# Optional. The GitHub App's numeric ID (unset = module disabled).
# FKST_GITHUB_APP_ID=

# Required if FKST_GITHUB_APP_ID is set. Inline PEM private key.
# Use literal '\n' escapes for newlines. Mutually exclusive with _PATH.
# FKST_GITHUB_APP_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Required if FKST_GITHUB_APP_ID is set. Path to a local private key PEM file.
# Mutually exclusive with _PEM.
# FKST_GITHUB_APP_PRIVATE_KEY_PATH=/etc/fkst-github-app/key.pem

# Optional. URL-friendly slug of the GitHub App (e.g. "fkst-hosted").
# Used to construct actionable installation-hint URLs in 422 error messages.
# FKST_GITHUB_APP_SLUG=

# Optional. Base URL for the GitHub-token identity check behind the per-user
# environment/secret store (`GET {base}/user` resolves the caller's {login, id}).
# Default: https://api.github.com. Override only for a GitHub Enterprise host or
# to point tests at a mock server. Must not be blank.
# FKST_GITHUB_API_BASE_URL=https://api.github.com

# Optional. Global write posture (engine/deployment-level — not consumed by fkst-control-plane; governs the substrate dev-loop write posture).
# Default: DRY-RUN (no writes/merges carried out).
# Set to 'REAL' (or '1') in production to enable autonomous writes/merges.
FKST_GITHUB_WRITE=DRY-RUN


# ------------------------------------------------------------------------------
# 6. Journaling Configuration (Status Commits)
# ------------------------------------------------------------------------------

# Optional. Master token for fallback journaling repository access.
# If absent, GitHub journaling is disabled (no durable floor) with a warning.
# GITHUB_TOKEN=ghp_REPLACE_ME

# Optional. Switch to enable/disable GitHub journaling (the sole machine-truth).
# Default: true
FKST_JOURNAL_GITHUB_ENABLED=true

# Optional. Owner/name of the dedicated journal repo.
# If absent, GitHub journaling is disabled (no durable floor, warning).
# FKST_JOURNAL_GITHUB_REPO=

# Optional. Git branch to push journals to.
# Default: main
FKST_JOURNAL_GITHUB_BRANCH=main

# Optional. Flush debounce time in milliseconds for buffering completions.
# Default: 2000
FKST_JOURNAL_FLUSH_INTERVAL_MS=2000

# Optional. Force flush once buffer reaches this size.
# Default: 50
FKST_JOURNAL_FLUSH_MAX_BATCH=50

# Optional. Mirror completions as issue comments on GitHub (disabled by default).
# Default: false
FKST_JOURNAL_ISSUE_COMMENTS=false

# Optional. Max retries for handling optimistic concurrency conflicts.
# Default: 5
FKST_JOURNAL_CAS_MAX_RETRIES=5


# ------------------------------------------------------------------------------
# 7. Event Identity Pointers
# ------------------------------------------------------------------------------

# Optional. Comma-separated JSON pointers used to define event uniqueness.
# Default: /department,/source,/name,/corr
FKST_RAISED_IDENTITY_POINTERS=/department,/source,/name,/corr

# Optional. Max stdout line length parsed before truncation.
# Default: 1048576
FKST_RAISED_MAX_LINE_BYTES=1048576


# ------------------------------------------------------------------------------
# 8. chrono-storage log streaming (OPTIONAL)
# ------------------------------------------------------------------------------
# The control plane streams every session's redacted logs to chrono-storage (a
# MinIO/S3 front BEHIND the NyxID proxy) as a `tar.gz` bundle at
# `logs/<session_id>/latest.tar.gz`. Every call carries a NyxID service-account
# OAuth2 client-credentials access token as `Authorization: Bearer`.
#
# The whole feature is OPTIONAL: leave ALL five core vars unset and no bundle is
# produced (the process boots normally). Setting SOME but not all of the five is
# a misconfiguration and fails closed at startup, naming the missing vars.
#
# base_url + bucket + token_url + client_id are non-secret (ConfigMap); the
# client secret is a Secret (never logged, redacted in Debug).

# Base URL of the proxied chrono-storage service (trailing slashes trimmed).
# FKST_STORAGE_BASE_URL=https://storage.chrono-ai.fun

# Bucket every session-log object is written to / read from.
# FKST_STORAGE_BUCKET=fkst-session-logs

# NyxID OAuth2 token endpoint (client-credentials grant).
# FKST_NYXID_TOKEN_URL=https://nyx.chrono-ai.fun/oauth/token

# NyxID service-account client id — the control plane's READ/responder SA (an
# OAuth client identifier, not a secret).
# FKST_NYXID_CLIENT_ID=CHANGE_ME

# The read SA's client secret. SECRET — keep out of version control.
# FKST_NYXID_CLIENT_SECRET=CHANGE_ME

# --- write-only SA handed to session pods (OPTIONAL) ---
# A SECOND, WRITE-ONLY service account the control plane injects into every
# session Secret so the in-pod log uploader can PUT its bundle without ever
# gaining read/list/delete on the bucket (scope: storage-write). The
# base-url/bucket/token-url above are SHARED; only the client-id/secret differ.
# Leave both unset to disable per-session bundle uploads (fail-closed).
#
# The write-only SA client id (an OAuth client identifier, not a secret).
# FKST_STORAGE_WRITER_CLIENT_ID=CHANGE_ME
#
# The write-only SA client secret. SECRET — keep out of version control.
# FKST_STORAGE_WRITER_CLIENT_SECRET=CHANGE_ME


# ------------------------------------------------------------------------------
# 9. Pod-per-session dispatch (OPTIONAL)
# ------------------------------------------------------------------------------
# See backend/k8s_sample/configmap.yaml for the full pod-dispatch knob set
# (FKST_POD_DISPATCH / FKST_POD_IMAGE / …). Documented here: the backend selector.

# Session-execution backend. Default value is "k8s-customized" (one Kubernetes
# Job per session). "opensandbox" (one OpenSandbox sandbox per session) is now
# available; when selected with FKST_POD_DISPATCH=true it REQUIRES the FKST_OSB_*
# block below (missing/invalid vars fail closed at startup). Leave unset for the
# default.
# FKST_POD_MODE=k8s-customized

# --- OpenSandbox backend (FKST_OSB_*, only when FKST_POD_MODE=opensandbox) ---
# Validated only when FKST_POD_DISPATCH=true AND FKST_POD_MODE=opensandbox; a
# k8s-customized deploy never sets these. FKST_POD_IMAGE + FKST_POD_NAMESPACE
# still apply in opensandbox mode (the image is the sandbox image; the namespace
# binds the env-store client). FKST_POD_SERVICE_ACCOUNT / _DNS_NAMESERVERS /
# _RUNTIME_CLASS / _TERMINATION_GRACE_SECS are IGNORED (the sandbox template owns
# them) and warned about at startup if set.
#
# The two secrets (FKST_OSB_API_KEY, FKST_OSB_EXECD_TOKEN_SEED) live ONLY in the
# Secret — see backend/k8s_sample/secret.example.yaml. The knobs below are
# non-secret (ConfigMap).
#
# The OpenSandbox lifecycle server base URL (must be a valid URL).
# FKST_OSB_BASE_URL=https://sandbox.chrono-ai.fun/api
# The sandbox cpu / memory resource limits (non-blank).
# FKST_OSB_SESSION_CPU=500m
# FKST_OSB_SESSION_MEMORY=512Mi
# The absolute path of the in-sandbox control-plane binary the entrypoint runs
# (OpenSandbox has no image-default fallback, so it is always spelled out).
# FKST_OSB_ENTRYPOINT=/usr/local/bin/fkst-control-plane
# Whether execd is reached through the lifecycle proxy. Only "true" (the default)
# is supported; "false" fails closed. Leave unset.
# FKST_OSB_USE_SERVER_PROXY=true
# Reserved health-inspection toggle. Default false; no behaviour reads it yet.
# FKST_OSB_INSPECT_HEALTH=false

# --- in-pod run-substrate driver (OPTIONAL) ---
# Read by the in-pod `run-substrate` driver, NOT the control-plane API server: the
# bounded wait (seconds) for the credentials-complete sentinel (.creds-complete) to
# appear at the mounted creds volume before the engine starts. In k8s-customized mode
# the sentinel rides the atomic Secret mount, so the gate passes at ~0ms; the wait
# matters only for a backend that writes creds incrementally. On timeout the driver
# aborts engine start (non-zero exit). Blank/garbage falls back to the default.
# Default: 120
# FKST_CREDS_WAIT_TIMEOUT_SECS=120
